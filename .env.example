# 默认使用 hashing；本地真实语义检索请使用 start-semantic.ps1 或 docs/EMBEDDING_V011.md。
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# local_e5 可选配置；模型需先用 scripts.fetch_embedding_model 下载。
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_MODEL_DIR=work/models/multilingual-e5-small/614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CPU_THREADS=4
EMBEDDING_DEVICE=cpu

# 未配置密钥时，系统会返回基于证据片段的抽取式答案。
LLM_PROVIDER=extractive
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_BASE_URL=
LLM_VERIFY_SUPPORT=true
CONTEXT_CHAR_BUDGET=16000
# 可选 merged_neighbors：合并同章节重叠原文，按去重后的正文计预算。
CONTEXT_POLICY=neighbors

CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
DATA_DIR=data/index
