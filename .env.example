# 默认使用 hashing，零密钥也能跑通流程；正式演示请改为 openai_compatible。
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 未配置密钥时，系统会返回基于证据片段的抽取式答案。
LLM_PROVIDER=extractive
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_BASE_URL=

CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
DATA_DIR=data/index
