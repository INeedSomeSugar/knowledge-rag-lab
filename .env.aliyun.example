# 复制本文件为 .env，再填写新生成的密钥和控制台显示的 Base URL。
# 不要把真实密钥提交到 Git，也不要发送到聊天中。

DASHSCOPE_API_KEY=在这里填写新生成的密钥
DASHSCOPE_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v4

LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen3.7-plus
# 普通知识库问答不需要长思考，关闭可降低延迟和输出 Token 费用。
LLM_ENABLE_THINKING=false

CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=5
DATA_DIR=data/index
